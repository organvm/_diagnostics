#!/usr/bin/env bash
# mem-pressure-snapshot — on-demand, read-only capture of macOS memory/process
# pressure state.
#
# WHY: the 2026-05-21 sysdiagnose crisis (FIND-005) had to be reconstructed 48h
# late from stale logs. This tool freezes the LIVE picture the moment the machine
# feels slow, so the next episode is recorded as-it-happens, not inferred after.
#
# HARD CONSTRAINT (Rule #9): NO LaunchAgent, NO auto-trigger. Run by hand:
#     mem-pressure-snapshot            # human-readable, prints summary
#     mem-pressure-snapshot --quiet    # prints only the output path
# Optional convenience: alias mps='mem-pressure-snapshot'
#
# Every capture is read-only. Partial failures (missing tool, slow log) never
# abort the snapshot — best-effort is the contract.
set -euo pipefail

QUIET=0
[[ "${1:-}" == "--quiet" ]] && QUIET=1

SNAP_DIR="$HOME/.claude/projects/-Users-4jp-Workspace--diagnostics/snapshots"
mkdir -p "$SNAP_DIR"
STAMP="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
OUT="$SNAP_DIR/mem-$STAMP.md"

# Capture block runs in a subshell so `set +e` (best-effort) stays scoped here
# and does not leak into the strict setup logic above.
(
  set +e
  sec() { printf '\n## %s\n\n```\n' "$1"; }
  end() { printf '```\n'; }

  printf '# Memory-pressure snapshot — %s\n\n' "$STAMP"
  printf '%s\n' "- Host: $(sysctl -n machdep.cpu.brand_string 2>/dev/null)"
  printf '%s\n' "- RAM: $(sysctl -n hw.memsize 2>/dev/null | awk '{print $1/1073741824}') GB"
  printf '%s\n' "- $(uptime)"

  sec "Swap"
  sysctl vm.swapusage 2>/dev/null
  end

  sec "Memory pressure"
  memory_pressure 2>/dev/null | tail -6
  end

  sec "vm_stat"
  vm_stat 2>/dev/null | head -12
  end

  sec "Top 15 by resident memory (RSS)"
  ps aux -m 2>/dev/null | head -16 \
    | awk 'NR==1{print "USER       %CPU  %MEM      RSS  COMMAND"; next}
           {printf "%-10s %5s %5s %7dMB  %s\n",$1,$3,$4,int($6/1024),$11}'
  end

  sec "Top 10 by CPU"
  ps aux -r 2>/dev/null | head -11 \
    | awk 'NR==1{print "USER       %CPU  %MEM      RSS  COMMAND"; next}
           {printf "%-10s %5s %5s %7dMB  %s\n",$1,$3,$4,int($6/1024),$11}'
  end

  sec "Process counts & known pressure sources"
  printf 'claude-related : %s\n' "$(ps aux | grep -c '[c]laude')"
  printf 'node           : %s\n' "$(ps aux | grep -c '[n]ode')"
  printf 'opencode       : %s\n' "$(ps aux | grep -c '[o]pencode')"
  printf 'ipykernel      : %s   (FIND-001 — should be 0)\n' "$(ps aux | grep -c '[i]pykernel')"
  printf 'ollama         : %s   (FIND-002 — should be 0)\n' "$(ps aux | grep -c '[o]llama')"
  printf '\nElectron AI desktop apps running (FIND-005 co-residency):\n'
  apps="$(ps aux | grep -Eo '/Applications/[^ ]*(Claude|ChatGPT|Codex|Antigravity|Ollama)[^ ]*\.app' | sort -u)"
  if [[ -n "$apps" ]]; then printf '%s\n' "$apps"; else printf '  (none running)\n'; fi
  end

  sec "brew services (FIND-002 Ollama, atuin)"
  brew services list 2>/dev/null
  end

  sec "Sleep assertions (keep-awake)"
  pmset -g assertions 2>/dev/null \
    | grep -iE 'PreventUserIdleDisplaySleep|PreventSystemSleep|PreventUserIdleSystemSleep|named:'
  end

  sec "Disk"
  df -h / /System/Volumes/Data 2>/dev/null
  end

  sec "Memory kills — jetsam/OOM (last 6h)"
  # Narrow to actual kills; drop routine runningboard "Ignoring jetsam update"
  # chatter and the log-show invocation itself. Empty = healthy (or needs sudo).
  js="$(log show --predicate '(eventMessage CONTAINS[c] "jetsam" OR eventMessage CONTAINS "memorystatus") AND eventMessage CONTAINS[c] "kill"' --last 6h --style compact 2>/dev/null \
        | grep -ivE 'noninteractively|Ignoring jetsam update|Set jetsam priority' | tail -20)"
  if [[ -n "$js" ]]; then printf '%s\n' "$js"; else printf '(no memory kills in last 6h — healthy, or kernel events need sudo)\n'; fi
  end
) > "$OUT" || true

# --- JSON sidecar (machine-readable; consumed by `memdiag verdict|reconcile`) ---
# Re-samples the cheap signals (no log-show) so the markdown path above stays
# untouched. The trustworthy headline is mem_free_pct; swap_* and pages_free_mb
# are recorded but flagged unstable/misleading per the 2026-05-23 synthesis.
JOUT="${OUT%.md}.json"
(
  set +e
  free_pct="$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/[^0-9]/,"",$2); print $2+0}')"
  sw="$(sysctl -n vm.swapusage 2>/dev/null)"
  swap_used="$(printf '%s' "$sw" | sed -E 's/.*used = ([0-9.]+)M.*/\1/')"
  swap_total="$(printf '%s' "$sw" | sed -E 's/total = ([0-9.]+)M.*/\1/')"
  pgsz="$(vm_stat 2>/dev/null | sed -n 's/.*page size of \([0-9]*\) bytes.*/\1/p')"
  pgfree="$(vm_stat 2>/dev/null | awk '/Pages free/{gsub(/[^0-9]/,"",$3); print $3+0}')"
  pages_free_mb=$(( ${pgfree:-0} * ${pgsz:-16384} / 1048576 ))
  disk_pct="$(df -h /System/Volumes/Data 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5+0}')"
  ram_gb="$(sysctl -n hw.memsize 2>/dev/null | awk '{print int($1/1073741824)}')"
  host="$(sysctl -n machdep.cpu.brand_string 2>/dev/null)"
  load1="$(uptime 2>/dev/null | sed -E 's/.*load averages?: ([0-9.]+).*/\1/')"
  n_claude="$(ps aux 2>/dev/null | grep -c '[c]laude')"
  n_node="$(ps aux 2>/dev/null | grep -c '[n]ode')"
  n_open="$(ps aux 2>/dev/null | grep -c '[o]pencode')"
  n_ipy="$(ps aux 2>/dev/null | grep -c '[i]pykernel')"
  n_ollama="$(ps aux 2>/dev/null | grep -c '[o]llama')"
  top_json="$(ps aux -m 2>/dev/null | awk 'NR>1 && NR<=9{cmd=$11; rss=int($6/1024); gsub(/"/,"",cmd); printf "{\"cmd\":\"%s\",\"rss_mb\":%d}\n",cmd,rss}' | jq -s '.' 2>/dev/null)"
  ai_json="$(ps aux 2>/dev/null | grep -Eo '/Applications/[^ ]*(Claude|ChatGPT|Codex|Antigravity|Ollama)[^ ]*\.app' | sort -u | jq -R -s 'split("\n")|map(select(length>0))' 2>/dev/null)"

  jq -n \
    --arg     ts        "$STAMP" \
    --arg     host      "${host:-unknown}" \
    --argjson ram_gb    "${ram_gb:-0}" \
    --argjson free_pct  "${free_pct:-0}" \
    --argjson swap_used "${swap_used:-0}" \
    --argjson swap_tot  "${swap_total:-0}" \
    --argjson pages_free_mb "${pages_free_mb:-0}" \
    --argjson disk_pct  "${disk_pct:-0}" \
    --arg     load1     "${load1:-0}" \
    --argjson p_claude  "${n_claude:-0}" \
    --argjson p_node    "${n_node:-0}" \
    --argjson p_open    "${n_open:-0}" \
    --argjson p_ipy     "${n_ipy:-0}" \
    --argjson p_ollama  "${n_ollama:-0}" \
    --argjson top       "${top_json:-[]}" \
    --argjson ai        "${ai_json:-[]}" \
    '{timestamp:$ts, host:$host, ram_gb:$ram_gb,
      mem_free_pct:$free_pct,
      swap_used_mb:$swap_used, swap_total_mb:$swap_tot,
      pages_free_mb:$pages_free_mb,
      disk_data_pct:$disk_pct, load_1m:($load1|tonumber? // 0),
      procs:{claude:$p_claude, node:$p_node, opencode:$p_open, ipykernel:$p_ipy, ollama:$p_ollama},
      ai_apps:$ai, top_rss:$top}' > "$JOUT"
) 2>/dev/null || true

if [[ "$QUIET" -eq 1 ]]; then
  echo "$OUT"
else
  echo "Snapshot written: $OUT"
  echo "JSON sidecar    : $JOUT"
  echo
  grep -E 'vm.swapusage|free percentage|Capacity|Volumes/Data' "$OUT" 2>/dev/null || true
fi
