# ─────────────────────────────────────────────────────────────
# _diagnostics — what never enters version control
# ─────────────────────────────────────────────────────────────

# Raw diagnostic captures: regenerable, often huge/binary. The landing zone.
captures/raw/

# Capture blob types — ignored anywhere, as defense-in-depth.
*.heapsnapshot
*.pcap
*.diag
*.db
*.db-wal
claude-netlog-*.json
claude.ai-*.log
console-*.log
Claude-logs-*.zip
claude-diagnostic-*.zip
sysdiagnose-*/

# OS / editor noise
.DS_Store

# Node (the inquiry report keeps its own .gitignore too)
node_modules/
